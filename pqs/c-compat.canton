// Compatible (SCU) reload phases for runC.sh; PHASE selects the step, ids come in through env.
// mirrors 1.0.0 (G1, value : Text) -> 1.0.1 (G2, + note, + Bump) -> 1.0.2 (G3, + tag).
import com.daml.ledger.api.v2.value.Optional
def opt(v: Option[Value]) = Value(Value.Sum.Optional(Optional(v)))
def txt(s: String) = Value(Value.Sum.Text(s))
def mirrorFields(i: Int, note: Option[Option[String]], tag: Option[Option[Long]]) =
  Seq("owner" -> party, "value" -> txt(s"text-$i")) ++
    note.map(n => "note" -> opt(n.map(txt))).toSeq ++
    tag.map(t => "tag" -> opt(t.map(x => Value(Value.Sum.Int64(x))))).toSeq
def exercise(pkg: String, cid: String, choice: String) =
  submit(Command.Command.Exercise(ExerciseCommand(templateId = Some(Identifier(pkg, "Mirrors", "Mirror")),
    contractId = cid, choice = choice, choiceArgument = Some(Value(Value.Sum.Record(Record()))))))
def createdIn(tx: com.daml.ledger.api.v2.transaction.Transaction) =
  tx.events.filter(_.event.isCreated).map(_.getCreated.contractId)
def active(cid: String) = sandbox.ledger_api.state.acs.of_party(alice).exists(_.contractId == cid)
def reload(newDar: String, keep: Seq[String]) = {
  val pre = serial()
  val id = sandbox.dars.upload(newDar)  // FRED's compatible path: upload and vet, nothing removed
  val v = vetted()
  if (!v.contains(id)) throw new RuntimeException("new package not vetted")
  keep.foreach(k => if (!v.contains(k)) throw new RuntimeException(s"${k.take(12)} no longer vetted"))
  if (serial() - pre != 1) throw new RuntimeException(s"expected 1 topology transaction, got ${serial() - pre}")
  println(s"T NEW=$id"); println(s"T TOPO_DELTA=${serial() - pre}")
  id
}

env("PHASE") match {
  case "g1-create" =>
    val g1 = env("G1")
    val cids = (1 to 3).map(i => createC(g1, "Mirrors", "Mirror", mirrorFields(i, None, None)))
    cids.zipWithIndex.foreach { case (c, i) => println(s"T M${i + 1}=$c") }
    println(s"T LASTTX=$lastTx"); println(s"T END=${end()}")

  case "g2-reload" =>
    reload(env("G2_DAR"), Seq(env("G1")))
    val still = Seq("M1", "M2", "M3").map(k => active(env(k)))
    if (still.contains(false)) throw new RuntimeException(s"old contracts not all active: $still")
    println(s"T OLD_ACTIVE=${still.count(identity)}"); println(s"T END=${end()}")

  case "g2-use" =>
    val g2 = env("G2")
    (4 to 5).foreach(i => createC(g2, "Mirrors", "Mirror", mirrorFields(i, Some(Some("n")), None)))
    val bumped = createdIn(exercise(g2, env("M1"), "Bump"))
    exercise(g2, env("M2"), "Archive")
    if (active(env("M1")) || active(env("M2")) || !active(env("M3"))) throw new RuntimeException("unexpected m1/m2/m3 state")
    println(s"T M1_NEW=${bumped.mkString(",")}"); println(s"T LASTTX=$lastTx"); println(s"T END=${end()}")

  case "g2-later" =>
    createC(env("G2"), "Mirrors", "Mirror", mirrorFields(6, Some(Some("later")), None))
    println(s"T LASTTX=$lastTx"); println(s"T END=${end()}")

  case "g3" =>
    val g3 = reload(env("G3_DAR"), Seq(env("G1"), env("G2")))
    val c7 = createC(g3, "Mirrors", "Mirror", mirrorFields(7, Some(None), Some(Some(7L))))
    val bumped = createdIn(exercise(g3, env("M3"), "Bump"))
    if (active(env("M3"))) throw new RuntimeException("m3 still active after Bump")
    println(s"T C7=$c7"); println(s"T M3_NEW=${bumped.mkString(",")}")
    println(s"T LASTTX=$lastTx"); println(s"T END=${end()}")
}
