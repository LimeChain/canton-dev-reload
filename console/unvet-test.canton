import com.digitalasset.canton.topology.transaction.VettedPackage
import com.digitalasset.canton.topology.{ForceFlag, ForceFlags}
import com.digitalasset.canton.topology.admin.grpc.TopologyStoreId
val V1 = sys.env("POC_V1"); val V2 = sys.env("POC_V2")
val psid = sandbox.synchronizers.list_connected().head.physicalSynchronizerId
val store: TopologyStoreId = TopologyStoreId.Synchronizer(psid)
def acs() = sandbox.parties.list().map(_.party)
  .filter(p => { val i=p.uid.identifier.unwrap; i.startsWith("Alice")||i.startsWith("Bob") })
  .flatMap(p => sandbox.ledger_api.state.acs.of_party(p)).size
def vetted() = sandbox.topology.vetted_packages.list(store=Some(store)).flatMap(_.item.packages.map(_.packageId.toString)).toSet
println(s"START activeContracts=${acs()} v1Vetted=${vetted().contains(V1)}")

def t(label: String)(body: => Unit): Unit =
  scala.util.Try(body) match {
    case scala.util.Success(_) => println(s"$label => SUCCEEDED  (v1Vetted now ${vetted().contains(V1)})")
    case scala.util.Failure(e) => println(s"$label => FAILED: ${Option(e.getMessage).getOrElse(e.toString)}")
  }

// T1: plain unvet of V1 -- no adds, NO force flag -- while V1 has live contracts
t("T1 unvet-V1 no-force        ") {
  sandbox.topology.vetted_packages.propose_delta(participant = sandbox.id,
    adds = Seq.empty, removes = Seq(V1), store = store)
}
// T2: the swap WITHOUT the force flag
t("T2 swap-V1-out-V2-in no-force") {
  sandbox.topology.vetted_packages.propose_delta(participant = sandbox.id,
    adds = Seq(VettedPackage(V2, None, None)), removes = Seq(V1), store = store)
}
// T3: the swap WITH the force flag (what our fix does)
t("T3 swap WITH force          ") {
  sandbox.topology.vetted_packages.propose_delta(participant = sandbox.id,
    adds = Seq(VettedPackage(V2, None, None)), removes = Seq(V1), store = store,
    force = ForceFlags(ForceFlag.AllowVetIncompatibleUpgrades))
}
println(s"END activeContracts=${acs()}")
