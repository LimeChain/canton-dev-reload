import com.digitalasset.canton.topology.transaction.VettedPackage
import com.digitalasset.canton.topology.admin.grpc.TopologyStoreId
val psid  = sandbox.synchronizers.list_connected().head.physicalSynchronizerId
val store: TopologyStoreId = TopologyStoreId.Synchronizer(psid)
def vetted(): Set[String] = sandbox.topology.vetted_packages.list(store = Some(store))
  .flatMap(_.item.packages.map(_.packageId.toString)).toSet

// currently-vetted A and B
val v0 = vetted()
val oldA = sandbox.dars.list().filter(_.name=="items").map(_.mainPackageId).find(v0.contains).get
val oldB = sandbox.dars.list().filter(_.name=="holders").map(_.mainPackageId).find(v0.contains).get
println(s"OLD A=${oldA.take(12)} B=${oldB.take(12)}")

// upload BOTH unvetted
val newA = sandbox.dars.upload("artifacts/items.dar",   vetAllPackages = false)
val newB = sandbox.dars.upload("artifacts/holders.dar", vetAllPackages = false)
println(s"NEW A=${newA.take(12)} B=${newB.take(12)}")

// ONE topology transaction: two adds, two removes
scala.util.Try(sandbox.topology.vetted_packages.propose_delta(
  participant = sandbox.id,
  adds    = Seq(VettedPackage(newA, None, None), VettedPackage(newB, None, None)),
  removes = Seq(oldA, oldB),
  store   = store,
)) match {
  case scala.util.Success(_) => println("SWAP_BOTH => SUCCEEDED")
  case scala.util.Failure(e) => println("SWAP_BOTH => FAILED: " + Option(e.getMessage).getOrElse("?").take(160))
}
val v1 = vetted()
println(s"AFTER oldA=${v1.contains(oldA)} oldB=${v1.contains(oldB)} newA=${v1.contains(newA)} newB=${v1.contains(newB)}")
