// PHASE B -- the real experiment: reload while the old package HAS ACTIVE CONTRACTS.
// Params: POC_V1, POC_V2.
// Ordering is deliberate: try the cheap atomic swap FIRST. If that already works with
// live contracts, no purge (and no repair tooling) is needed at all.
import java.nio.file.{Files, Paths, StandardOpenOption}
import com.digitalasset.canton.topology.transaction.VettedPackage
import com.digitalasset.canton.topology.{ForceFlag, ForceFlags}
import com.digitalasset.canton.topology.admin.grpc.TopologyStoreId
import com.digitalasset.canton.SynchronizerAlias
import com.digitalasset.daml.lf.value.Value

val V1 = sys.env("POC_V1")
val V2 = sys.env("POC_V2")
val logPath = Paths.get("logs/ladder.log")

def rec(r: String, s: String, d: String): Unit = {
  val dd = d.replace("\n"," ").replaceAll("\\s+"," ").take(300)
  Files.write(logPath, s"$r|$s|$dd\n".getBytes, StandardOpenOption.CREATE, StandardOpenOption.APPEND)
  println(s"RUNG $r -> $s :: $dd")
}
def rung[T](n: String)(b: => T): Option[T] = scala.util.Try(b) match {
  case scala.util.Success(v) => rec(n,"PASS",String.valueOf(v).take(160)); Some(v)
  case scala.util.Failure(e) => rec(n,"FAIL",Option(e.getMessage).getOrElse(e.toString)); None
}
def skip(n: String, blocker: String): Unit = rec(n, s"SKIP(blocked-by=$blocker)", "precondition not met")

val psid  = sandbox.synchronizers.list_connected().head.physicalSynchronizerId
val alias = sandbox.synchronizers.list_connected().head.synchronizerAlias
val syncStore: TopologyStoreId = TopologyStoreId.Synchronizer(psid)

def eff(): Set[String] =
  sandbox.topology.vetted_packages.list(store = Some(syncStore))
    .flatMap(_.item.packages.map(_.packageId)).toSet
def parties(): Seq[com.digitalasset.canton.topology.PartyId] =
  sandbox.parties.list().map(_.party).filter(p =>
    p.uid.identifier.unwrap.startsWith("Alice") || p.uid.identifier.unwrap.startsWith("Bob"))
def acsIds(): Seq[String] =
  parties().flatMap(p => sandbox.ledger_api.state.acs.of_party(p).map(_.contractId)).distinct
def state(tag: String): Unit = {
  val e = eff()
  println(s"STATE[$tag] v1Vetted=${e.contains(V1)} v2Vetted=${e.contains(V2)} acs=${acsIds().size} parties=${parties().map(_.toProtoPrimitive.take(24)).mkString(";")}")
}

state("B-start")
val before = acsIds()
rec("B0-acs-snapshot", if (before.nonEmpty) "PASS" else "FAIL", s"activeContracts=${before.size}")

// B1: THE CRUX. Atomic vetting swap while V1 still has active contracts.
val swapped = rung("B1-atomic-swap-WITH-active-contracts") {
  sandbox.topology.vetted_packages.propose_delta(
    participant = sandbox.id,
    adds        = Seq(VettedPackage(V2, None, None)),
    removes     = Seq(V1),
    store       = syncStore,
    force       = ForceFlags(ForceFlag.AllowVetIncompatibleUpgrades),
  )
}
state("after-B1")

if (swapped.isEmpty) {
  // B1 failed -> the contracts are what block it. Purge them, then retry.
  val disc = rung("B2-disconnect-all") { sandbox.synchronizers.disconnect_all() }
  if (disc.isDefined) {
    val purged = rung("B3-repair-purge") {
      sandbox.repair.purge(alias, before.map(Value.ContractId.assertFromString), true)
    }
    rung("B4-reconnect-all") { sandbox.synchronizers.reconnect_all() }
    if (purged.isDefined) {
      rung("B5-atomic-swap-after-purge") {
        sandbox.topology.vetted_packages.propose_delta(
          participant = sandbox.id,
          adds        = Seq(VettedPackage(V2, None, None)),
          removes     = Seq(V1),
          store       = syncStore,
          force       = ForceFlags(ForceFlag.AllowVetIncompatibleUpgrades),
        )
      }
    } else skip("B5-atomic-swap-after-purge", "B3-repair-purge")
  } else {
    skip("B3-repair-purge", "B2-disconnect-all")
    skip("B4-reconnect-all", "B2-disconnect-all")
    skip("B5-atomic-swap-after-purge", "B2-disconnect-all")
  }
} else {
  // B1 succeeded: the swap did NOT require purging. Record what happened to the contracts.
  rec("B2-disconnect-all", "SKIP(not-needed)", "B1 succeeded with active contracts")
  rec("B3-repair-purge",   "SKIP(not-needed)", "B1 succeeded with active contracts")
  rec("B4-reconnect-all",  "SKIP(not-needed)", "B1 succeeded with active contracts")
  rec("B5-atomic-swap-after-purge", "SKIP(not-needed)", "B1 succeeded with active contracts")
  rec("B1x-acs-after-swap", "PASS", s"activeContractsStillVisible=${acsIds().size} (were ${before.size})")
}

state("B-end")
println("PHASE_B_DONE")
