// Post-reload invariants. Emits pipe-delimited lines so shell can parse them reliably.
// Contract labels are derived from what is ACTUALLY vetted -- a package is LIVE if vetted,
// ORPHAN if it still has contracts but is no longer vetted.
import com.digitalasset.canton.topology.admin.grpc.TopologyStoreId
val psid = sandbox.synchronizers.list_connected().head.physicalSynchronizerId
val store: TopologyStoreId = TopologyStoreId.Synchronizer(psid)
val vetted: Set[String] = sandbox.topology.vetted_packages.list(store = Some(store))
  .flatMap(_.item.packages.map(_.packageId.toString)).toSet

val mirrors = sandbox.dars.list().filter(_.name == "mirrors")
mirrors.foreach { d =>
  val live = if (vetted.contains(d.mainPackageId)) "LIVE" else "not-vetted"
  println(s"ASSERT|dar|${d.name}|${d.version}|${d.mainPackageId}|$live")
}

val ps = sandbox.parties.list().map(_.party).filter { p =>
  val i = p.uid.identifier.unwrap; i.startsWith("Alice") || i.startsWith("Bob") }
ps.foreach(p => println(s"ASSERT|party|${p.uid.identifier.unwrap}|${p.toProtoPrimitive}"))

ps.foreach { p =>
  sandbox.ledger_api.state.acs.of_party(p).groupBy(_.templateId.packageId).foreach {
    case (pkg, list) =>
      val label = if (vetted.contains(pkg.toString)) "LIVE" else "ORPHAN"
      println(s"ASSERT|acs|${p.uid.identifier.unwrap}|${pkg.toString.take(12)}|$label|${list.size}")
  }
}
println(s"ASSERT|ledgerEnd|${sandbox.ledger_api.state.end()}")
